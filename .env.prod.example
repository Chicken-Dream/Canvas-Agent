# Used with docker-compose.prod.yml on the deployed EC2 instance (see
# AWS_SETUP.md step 5) - NOT for local dev, which uses .env.example
# and docker-compose.yml instead. Copy to `.env` next to
# docker-compose.prod.yml on the instance and fill in real values.

POSTGRES_DB=canvas_agent
POSTGRES_USER=canvas_agent
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change_me

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change_me_to_a_random_string

# The domain Caddy requests a Let's Encrypt certificate for - must already
# resolve (via DNS) to this instance's Elastic IP before first startup.
DOMAIN=canvas-agent.yourdomain.com

CANVAS_BASE_URL=https://canvas.ualberta.ca

# No AWS_ACCESS_KEY_ID/SECRET here - the EC2 instance's own IAM role
# (canvas-agent-ec2-role) grants Bedrock access instead.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
