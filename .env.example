# Copy this file to `.env` in the project root before running docker-compose.
# `.env` is read automatically by docker-compose.

# --- Postgres ---
POSTGRES_DB=canvas_agent
POSTGRES_USER=canvas_agent
POSTGRES_PASSWORD=change_me

# --- Canvas (University of Alberta instance) ---
CANVAS_BASE_URL=https://canvas.ualberta.ca

# OAuth2 developer key. On an institutional Canvas instance these must be
# issued by the school's Canvas admin (UAlberta IT) - see README.md for the
# request process and for the Personal-Access-Token fallback used by this
# prototype in the meantime.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:8000/auth/canvas/callback

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
# Random long string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change_me_to_a_random_string
# Local dev over plain HTTP on localhost: leave both as-is. A real HTTPS
# deployment with the frontend and backend on different origins needs
# SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=none instead, or
# the browser silently drops the session cookie. See DEPLOYMENT_PLAN.md.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- AWS Bedrock (urgency-ranking agent, see README "Urgency agent") ---
# IAM user credentials with bedrock:InvokeModel / bedrock:Converse access.
# Required only for the "Evaluate my assignments" button - everything else
# works without these set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
